{
  "structuredDataSchema": {
    "type": "object",
    "properties": {
      "partNumber": {
        "type": "string",
        "description": "The manufacturer or supplier part number"
      },
      "partName": {
        "type": "string",
        "description": "Name or description of the automotive part"
      },
      "price": {
        "type": "number",
        "description": "Cost price for the part in CAD"
      },
      "retailPrice": {
        "type": "number", 
        "description": "Retail/list price for the part in CAD"
      },
      "quantity": {
        "type": "integer",
        "description": "Number of parts available or quoted",
        "minimum": 1
      },
      "availability": {
        "type": "string",
        "enum": ["in_stock", "backorder", "discontinued", "special_order"],
        "description": "Current availability status of the part"
      },
      "eta": {
        "type": "string",
        "description": "Estimated time of arrival or delivery timeframe"
      },
      "supplierPartNumber": {
        "type": "string",
        "description": "Supplier's internal part number or SKU"
      },
      "brand": {
        "type": "string",
        "description": "Brand or manufacturer of the part"
      },
      "condition": {
        "type": "string",
        "enum": ["new", "used", "refurbished", "remanufactured"],
        "description": "Condition of the part"
      },
      "warranty": {
        "type": "string",
        "description": "Warranty information for the part"
      },
      "minimumOrderQuantity": {
        "type": "integer",
        "description": "Minimum quantity required for order",
        "minimum": 1
      },
      "supplierName": {
        "type": "string",
        "description": "Name of the supplier providing the quote"
      },
      "contactPerson": {
        "type": "string",
        "description": "Name of the contact person at the supplier"
      },
      "quoteValidUntil": {
        "type": "string",
        "description": "Date until which the quote is valid"
      },
      "specialInstructions": {
        "type": "string",
        "description": "Any special instructions or notes about the part or order"
      },
      "coreCharge": {
        "type": "number",
        "description": "Core charge amount if applicable"
      },
      "shipping": {
        "type": "object",
        "properties": {
          "cost": {
            "type": "number",
            "description": "Shipping cost"
          },
          "method": {
            "type": "string",
            "description": "Shipping method (standard, expedited, overnight, etc.)"
          },
          "carrier": {
            "type": "string",
            "description": "Shipping carrier (UPS, FedEx, USPS, etc.)"
          }
        }
      },
      "quoteProbability": {
        "type": "string",
        "enum": ["confirmed", "tentative", "pending_verification"],
        "description": "Confidence level of the quote information"
      },
      "alternativeParts": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "partNumber": { "type": "string" },
            "partName": { "type": "string" },
            "price": { "type": "number" },
            "availability": { "type": "string" }
          }
        },
        "description": "Alternative or compatible parts suggested"
      }
    },
    "required": [
      "partNumber",
      "partName", 
      "price",
      "availability",
      "eta",
      "supplierName"
    ]
  }
}
